---
import Layout from '../layouts/Layout.astro';
import {getContent} from '../lib/content';
const {settings:s}=await getContent();
---
<Layout title="Contact"><section class="wrap section contact-page"><div class="contact-intro"><h1>Contact us</h1><p class="lead">Contact the clinic to ask a question or arrange a consultation.</p></div><div class="contact-methods"><a href={`tel:${s.phone.replace(/\s/g,'')}`}><span>Telephone</span><strong>{s.phone}</strong><small>Call the clinic ↗</small></a><a href={`tel:${s.mobile.replace(/\s/g,'')}`}><span>Mobile</span><strong>{s.mobile}</strong><small>Call our mobile ↗</small></a><a href={`mailto:${s.email}`}><span>Email</span><strong>{s.email}</strong><small>Send an email ↗</small></a></div><section class="visit-panel"><div><h2>Visit our clinic</h2><p>{s.address}</p><a class="text-link" href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(s.address)}`} target="_blank" rel="noopener noreferrer">Get directions ↗</a></div><div><h2>Opening hours</h2><ul>{s.hours.map(h=><li>{h}</li>)}</ul></div></section></section></Layout>