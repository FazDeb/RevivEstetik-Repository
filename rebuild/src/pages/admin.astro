---
const entries=import.meta.glob('../..//content/treatments/*.json',{eager:true,import:'default'});
const treatmentPaths=Object.fromEntries(Object.entries(entries).map(([file,t])=>[file.split('/').pop().replace('.json',''),'/treatments/'+t.slug+'/']));
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>RevivEstetik editor</title><style is:global>html,body{margin:0;height:100%;font:14px Arial,sans-serif;background:#f7f7f7}.editor-bar{height:64px;box-sizing:border-box;display:flex;align-items:center;justify-content:space-between;gap:18px;padding:10px 22px;border-bottom:1px solid #ddd;background:white}.editor-bar strong{color:#800000}.editor-bar small{display:block;color:#666;margin-top:5px}.editor-bar a{background:#800000;color:white;padding:12px 18px;text-decoration:none;border-radius:4px;white-space:nowrap}iframe{display:block;border:0;width:100%;height:calc(100vh - 64px)}@media(max-width:520px){.editor-bar{padding:8px 12px}.editor-bar small{font-size:10px}}</style></head><body><header class="editor-bar"><div><strong>RevivEstetik Â· Content editor</strong><small>Save with Publish, then preview. Return to this tab to keep editing.</small></div><a id="preview" href="/" target="revivestetik-preview">Preview website â†—</a></header><iframe id="editor" title="Website content editor" src="/admin/editor/"></iframe><script define:vars={{treatmentPaths}}>
const frame=document.getElementById('editor');const link=document.getElementById('preview');
if(!['localhost','127.0.0.1'].includes(location.hostname))document.querySelector('.editor-bar small').textContent='Publish updates the test site. Allow time for the rebuild before previewing.';
function sync(){try{const hash=frame.contentWindow.location.hash;history.replaceState(null,'',hash||location.pathname);const parts=hash.split('/');const section=parts[2];const entry=decodeURIComponent(parts[4]||'');link.href=section==='treatments'?(treatmentPaths[entry]||'/treatments/'):section==='about'?'/about/':section==='contact'?'/contact/':section==='footer'?'/#footer':'/';}catch{}}
if(location.hash)frame.src='/admin/editor/'+location.hash;
frame.addEventListener('load',()=>{sync();frame.contentWindow.addEventListener('hashchange',sync);});
</script></body></html>
